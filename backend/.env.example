# =====================================================================
# Salin file ini menjadi .env lalu isi nilainya:   cp .env.example .env
# JANGAN commit file .env (sudah tercantum di .gitignore).
# =====================================================================

# --- Aplikasi ---
APP_ENV=development
LOG_LEVEL=INFO
APP_TIMEZONE=Asia/Jakarta

# --- PostgreSQL (dipakai docker-compose untuk service db & api) ---
POSTGRES_USER=skinsight
# Hindari karakter @ : / ? # % agar password aman ditulis di dalam URL koneksi.
POSTGRES_PASSWORD=ganti-password-database
POSTGRES_DB=skinsight
# Port di komputer host untuk service db (5433 agar tidak bentrok dengan PostgreSQL lokal di 5432).
POSTGRES_PORT=5433
API_PORT=8000

# URL database untuk menjalankan API / alembic / pytest DI LUAR Docker (mengarah ke service db di port 5433).
# Di dalam Docker, docker-compose.yml otomatis menimpa nilai ini agar memakai host "db".
DATABASE_URL=postgresql+psycopg://skinsight:ganti-password-database@localhost:5433/skinsight
TEST_DATABASE_URL=postgresql+psycopg://skinsight:ganti-password-database@localhost:5433/skinsight_test

# --- JWT ---
# WAJIB diganti dengan string acak minimal 32 karakter. Contoh cara membuat:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=ganti-dengan-string-acak-minimal-32-karakter
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- CORS: daftar origin dipisah koma; "*" = semua origin (cukup untuk development) ---
CORS_ORIGINS=*

# --- Upload & privasi foto ---
MAX_UPLOAD_SIZE_MB=5
# false = foto TIDAK disimpan (hanya hasil prediksi & metadata).
# Ubah ke true hanya jika ada persetujuan pengguna dan kebijakan penyimpanan data yang jelas.
SAVE_SCAN_IMAGES=false
SCAN_IMAGE_DIR=storage/scans

# --- Machine Learning: mock | local | remote ---
ML_MODE=mock
# Mode local: file model hasil training (YOLOv8n-cls dari branch Rafazl -> ml_models/best.pt)
ML_MODEL_PATH=ml_models/best.pt
ML_IMAGE_SIZE=224
# Urutan label = urutan indeks output model (untuk file .pt dibaca otomatis dari model)
ML_LABELS=combination,dry,normal,oily
# Mode remote: URL endpoint prediksi API ML terpisah, contoh http://ml-api:9000/predict
ML_API_URL=
ML_API_TIMEOUT_SECONDS=15
# Build image Docker beserta dependency ML (ultralytics + torch CPU). Wajib true jika ML_MODE=local di Docker.
INSTALL_ML=false

# --- Rate limiting (per IP, per jendela waktu) ---
RATE_LIMIT_ENABLED=true
RATE_LIMIT_AUTH_REQUESTS=10
RATE_LIMIT_AUTH_WINDOW_SECONDS=60
RATE_LIMIT_SCANS_REQUESTS=30
RATE_LIMIT_SCANS_WINDOW_SECONDS=60
